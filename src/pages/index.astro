---
import Layout from '../layouts/Layout.astro';

const profileLinks = [
	{ label: 'CV', href: '/resume.pdf', primary: true },
	{ label: 'GitHub', href: 'https://github.com/Kenxzk', external: true },
	{ label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=wLJvNMoAAAAJ', external: true },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/xiaokun-ken-zhong/', external: true },
	{ label: 'Email', href: 'mailto:xzhongal@berkeley.edu' },
];

const news = [
	{
		date: 'Nov 2026',
		text: 'Exploring computational protein design and the reliability of model-based screening through an independent competition project.',
	},
	{
		date: 'Nov 2026',
		text: 'Developing SciML AutoResearch: agent-assisted experiments with controlled evaluation on neural operator benchmarks.',
	},
	{
		date: 'May 2026',
		text: 'Our scientific ML paper was accepted to ICML 2026.',
	},
	{
		date: '2025-2026',
		text: 'Conducted scientific machine learning research with Dartmouth and Berkeley collaborators.',
	},
	{
		date: 'May 2026',
		text: 'Graduated from HKUST with a BSc in Mathematics, Computer Science Track.',
	},
];

const publications = [
	{
		title:
			'Unveiling Multi-regime Patterns in SciML: Distinct Failure Modes and Regime-specific Optimization',
		venue: 'ICML 2026',
		authors: 'Yuxin Wang*, Yuanzhe Hu*, Xiaokun Zhong* et al.',
		note: '* Equal contribution · Co-first authors',
		links: [
			{ label: 'Proceedings', href: 'https://proceedings.mlr.press/v306/wang26cc.html' },
			{ label: 'arXiv', href: 'https://arxiv.org/abs/2605.29153' },
			{ label: 'Code', href: 'https://github.com/leastima/sciml_multi_regime' },
		],
	},
];

const researchWorkflow = [
	{ title: 'Propose a change', detail: 'Constrain agent edits to the experiment code.' },
	{ title: 'Run a controlled experiment', detail: 'Keep evaluation and training budgets fixed.' },
	{ title: 'Evaluate and record', detail: 'Log the decision; check selected candidates across seeds.' },
];

const experience = [
	{
		role: 'Research Engineer, ML Systems & Scientific AI',
		org: 'Dartmouth College · UC Berkeley collaborators',
		date: 'Feb 2025 - Present',
		location: 'Berkeley, CA',
		points: [
			'Investigated failure modes and training instability in scientific AI systems under stiff PDE and other challenging regimes.',
			'Implemented second-order optimization pipelines in PyTorch and scaled reproducible experiments on Slurm-based HPC clusters.',
		],
	},
	{
		role: 'Research Engineer, Medical Imaging AI',
		org: 'HKUST Undergraduate Research Program',
		date: 'Feb 2023 - May 2025',
		location: 'Hong Kong',
		points: [
			'Developed deep learning workflows for MRI reconstruction and 3D volumetric modeling from sparse medical data.',
			'Improved Python and C++ data processing pipelines for faster experimentation on large imaging datasets.',
		],
	},
	{
		role: 'BSc in Mathematics, Computer Science Track',
		org: 'Hong Kong University of Science & Technology',
		date: 'Sep 2022 - Jun 2026',
		location: 'Hong Kong',
		points: [
			'Coursework includes differential equations, artificial intelligence, and probability theory.',
			'Visiting student in Computer Science at UC Berkeley from Dec 2025 to May 2026.',
		],
	},
];

const projects = [
	{
		title: 'Medical Imaging AI',
		summary:
			'Deep learning models and data pipelines for MRI reconstruction and 3D volumetric modeling from sparse medical data.',
		tags: ['Python', 'C++', 'Medical imaging', 'Deep learning'],
		links: [],
	},
	{
		title: 'Secure Network Tunneling & Transport Optimization',
		summary:
			'Cross-region networking system using TLS-based transport and system-level tuning for reliability and latency analysis.',
		tags: ['Linux', 'TLS', 'Networking', 'Systems'],
		links: [],
	},
	{
		title: 'Autonomous Robotics Vision System',
		summary:
			'Real-time computer vision and embedded control work for target acquisition in RoboMaster robotics.',
		tags: ['OpenCV', 'Python', 'C++', 'STM32'],
		links: [],
	},
];
---

<Layout
	title="Xiaokun (Ken) Zhong | ML Researcher & Engineer"
	description="Xiaokun (Ken) Zhong is an ML researcher and engineer, ICML 2026 co-first author, working on scientific ML, autonomous research, and computational protein design."
>
	<main id="main-content">
		<section class="mx-auto max-w-5xl px-6 pb-14 pt-10 sm:pb-18 sm:pt-16">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-700">
					ML Researcher & Engineer
				</p>
				<h1 class="mt-5 text-4xl font-semibold tracking-normal text-neutral-950 sm:text-5xl">
					Xiaokun (Ken) Zhong
				</h1>
				<p class="mt-5 max-w-2xl text-xl leading-8 text-neutral-700">
					Scientific ML · Autonomous Research · AI for Biology
				</p>
				<p class="mt-5 max-w-2xl text-base leading-7 text-neutral-700">
					I study how machine learning models fail and build tools for systematic scientific experimentation. I’m a co-first author of an ICML 2026 paper on optimization failure modes in scientific machine learning.
				</p>
				<p class="mt-4 max-w-2xl text-base leading-7 text-neutral-600">
					My work connects understanding ML failures, automating experiments, and applying ML to biological design. I’m developing SciML AutoResearch and exploring protein modeling and design, with a focus on reliable evaluation.
				</p>
				<p class="mt-4 text-base leading-7 text-neutral-600">
					HKUST Mathematics graduate (Computer Science Track), with research experience alongside Dartmouth and UC Berkeley collaborators.
				</p>
				<div class="mt-8 flex flex-wrap gap-3" aria-label="Profile links">
					{profileLinks.map((link) =>
						link.href ? (
							<a
								href={link.href}
								target={link.external ? '_blank' : undefined}
								rel={link.external ? 'noreferrer' : undefined}
								class:list={[
									'inline-flex min-h-11 items-center rounded-md px-4 text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700',
									link.primary
										? 'bg-neutral-950 text-white hover:bg-neutral-800'
										: 'border border-neutral-300 text-neutral-800 hover:border-teal-700 hover:text-teal-800',
								]}
							>
								{link.label}
							</a>
						) : (
							<span class="inline-flex min-h-11 items-center gap-2 rounded-md border border-dashed border-neutral-300 px-4 text-sm font-semibold text-neutral-500" aria-disabled="true">
								{link.label}
								<span class="text-xs font-medium uppercase text-teal-700">{link.note}</span>
							</span>
						)
					)}
				</div>
			</div>
		</section>

		<section id="research" class="border-t border-neutral-200 bg-white">
			<div class="mx-auto grid max-w-5xl gap-8 px-6 py-12 sm:py-14 md:grid-cols-[220px_1fr]">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Research</p>
					<h2 class="mt-2 text-2xl font-semibold text-neutral-950">From ML failures to scientific discovery</h2>
				</div>
				<div class="space-y-8">
					{publications.map((publication) => (
						<article id="publications" class="border-t-2 border-teal-700 pt-6">
							<p class="text-sm font-semibold text-teal-800">Published research · {publication.venue}</p>
							<h3 class="mt-3 text-2xl font-semibold leading-8 text-neutral-950">Understanding when—and why—optimization methods fail</h3>
							<dl class="mt-6 space-y-5">
								<div>
									<dt class="text-sm font-semibold text-neutral-950">Research question</dt>
									<dd class="mt-1 text-base leading-7 text-neutral-700">Why do scientific ML models fail under different training conditions, and which optimization methods help in each regime?</dd>
								</div>
								<div>
									<dt class="text-sm font-semibold text-neutral-950">Key finding</dt>
									<dd class="mt-1 text-base leading-7 text-neutral-700">Across physics-informed neural networks, neural operators, and neural ODEs, we identify three training regimes: well-trained, under-trained, and over-trained. Optimization effectiveness depends on the regime; no single method performs well across all three.</dd>
								</div>
								<div>
									<dt class="text-sm font-semibold text-neutral-950">My contribution</dt>
									<dd class="mt-1 text-base leading-7 text-neutral-700">As a co-first author, I investigated failure modes, implemented second-order optimization pipelines in PyTorch, and built reproducible Slurm workflows for ablation studies and model behavior analysis.</dd>
								</div>
							</dl>
							<div class="mt-7 border-t border-neutral-200 pt-5">
								<h4 class="text-base font-semibold leading-7 text-neutral-950">{publication.title}</h4>
							</div>
							<p class="mt-3 text-sm leading-6 text-neutral-700">{publication.authors}</p>
							<p class="mt-1 text-xs text-neutral-500">{publication.note}</p>
							<div class="mt-4 flex flex-wrap gap-3">
								{publication.links.map((link) =>
									link.href ? (
										<a class="inline-flex min-h-10 items-center rounded-md border border-neutral-300 px-3 text-sm font-semibold text-neutral-800 hover:border-teal-700 hover:text-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700" href={link.href} target="_blank" rel="noreferrer">
											{link.label}
										</a>
									) : (
										<span class="inline-flex min-h-10 items-center rounded-md border border-dashed border-neutral-300 px-3 text-sm font-semibold text-neutral-500" aria-disabled="true">
											{link.label}
										</span>
									)
								)}
							</div>
						</article>
					))}
					<article id="sciml-autoresearch" class="rounded-lg border border-teal-200 bg-teal-50/50 p-6 sm:p-7">
						<p class="text-sm font-semibold text-teal-800">Implemented workflow · Ongoing research</p>
						<h3 class="mt-3 text-2xl font-semibold text-neutral-950">SciML AutoResearch</h3>
						<p class="mt-4 text-base leading-7 text-neutral-700">I develop agent-assisted experiment workflows for scientific ML, including Fourier neural operators (FNOs) on Darcy flow and Transolver on ShapeNet-Car. The research question is how to turn experimental feedback into useful next experiments under controlled evaluation.</p>
						<dl class="mt-5 space-y-4">
							<div>
								<dt class="text-sm font-semibold text-neutral-950">My contribution</dt>
								<dd class="mt-1 text-base leading-7 text-neutral-700">PyTorch experiment controls with constrained agent edits, fixed evaluation protocols and training budgets, and experiment records tied to code revisions.</dd>
							</div>
							<div>
								<dt class="text-sm font-semibold text-neutral-950">Evaluation</dt>
								<dd class="mt-1 text-base leading-7 text-neutral-700">Completed benchmark runs include recorded keep-or-reject decisions and confirmation across random seeds. I’m studying how diagnostic feedback changes the search process; comparative findings remain unpublished.</dd>
							</div>
						</dl>
						<figure class="mt-6 border-t border-teal-200 pt-5" aria-labelledby="workflow-caption">
							<figcaption id="workflow-caption" class="text-sm font-semibold text-neutral-950">The experiment loop</figcaption>
							<ol class="mt-4 grid gap-4 lg:grid-cols-3">
								{researchWorkflow.map((step, index) => (
									<li class="border-l-2 border-teal-300 pl-3">
										<p class="text-xs font-semibold text-teal-800">0{index + 1}</p>
										<p class="mt-1 text-sm font-semibold leading-5 text-neutral-950">{step.title}</p>
										<p class="mt-2 text-sm leading-6 text-neutral-600">{step.detail}</p>
									</li>
								))}
							</ol>
						</figure>
					</article>
					<article id="protein-design" class="rounded-lg border border-neutral-200 p-6 sm:p-7">
						<p class="text-sm font-semibold text-teal-800">Independent project · Computationally evaluated · Ongoing</p>
						<h3 class="mt-3 text-2xl font-semibold text-neutral-950">Computational Protein Design</h3>
						<p class="mt-4 text-base leading-7 text-neutral-700">An independent exploration of KRAS G12D peptide–MHC binder design for the Anthropic × Adaptyv 2026 Protein Design Competition, extending my work in scientific ML into AI for Biology.</p>
						<dl class="mt-5 space-y-4">
							<div>
									<dt class="text-sm font-semibold text-neutral-950">What I built</dt>
									<dd class="mt-1 text-base leading-7 text-neutral-700">Candidate-generation workflows using BoltzGen and SolubleMPNN, with Boltz-2 and ESMFold2 evaluation against the mutant target, wild-type target, and peptide-free control.</dd>
								</div>
								<div>
									<dt class="text-sm font-semibold text-neutral-950">Experimental rigor</dt>
									<dd class="mt-1 text-base leading-7 text-neutral-700">Sequence and structure checks, matched-seed comparisons, interface geometry analysis, and reproducible GPU runs with archived inputs and outputs. Current work tests the screening criteria against published binding references and an assay-reported nonbinding case.</dd>
								</div>
							</dl>
						<p class="mt-5 border-t border-neutral-200 pt-4 text-sm leading-6 text-neutral-600">As of November 6, 2026: computational evaluation is ongoing; no competition submission or wet-lab binding validation.</p>
						<a class="mt-4 inline-flex min-h-10 items-center rounded-md border border-neutral-300 px-3 text-sm font-semibold text-neutral-800 hover:border-teal-700 hover:text-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700" href="https://proteinbase.com/competitions/anthropic-adaptyv-2026/challenges/pmhc" target="_blank" rel="noreferrer">Competition challenge</a>
					</article>
				</div>
			</div>
		</section>

		<section id="news" class="border-t border-neutral-200">
			<div class="mx-auto grid max-w-5xl gap-8 px-6 py-12 sm:py-14 md:grid-cols-[220px_1fr]">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">News</p>
					<h2 class="mt-2 text-2xl font-semibold text-neutral-950">Recent updates</h2>
				</div>
				<ol class="space-y-5">
					{news.map((item) => (
						<li class="grid gap-2 border-b border-neutral-200 pb-5 sm:grid-cols-[120px_1fr]">
							<time class="text-sm font-semibold text-neutral-500">{item.date}</time>
							<p class="text-base leading-7 text-neutral-700">{item.text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<section id="experience" class="border-t border-neutral-200">
			<div class="mx-auto grid max-w-5xl gap-8 px-6 py-12 sm:py-14 md:grid-cols-[220px_1fr]">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Experience</p>
					<h2 class="mt-2 text-2xl font-semibold text-neutral-950">Research and education</h2>
				</div>
				<div class="space-y-7">
					{experience.map((item) => (
						<article class="border-b border-neutral-200 pb-7 last:border-b-0 last:pb-0">
							<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
								<div>
									<h3 class="text-lg font-semibold text-neutral-950">{item.role}</h3>
									<p class="mt-1 text-sm font-medium text-neutral-700">{item.org}</p>
								</div>
								<div class="text-left sm:text-right">
									<p class="text-sm font-semibold text-neutral-600">{item.date}</p>
									<p class="mt-1 text-sm text-neutral-500">{item.location}</p>
								</div>
							</div>
							<ul class="mt-4 space-y-2">
								{item.points.map((point) => (
									<li class="flex gap-3 text-sm leading-6 text-neutral-700">
										<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-700"></span>
										<span>{point}</span>
									</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="projects" class="border-t border-neutral-200 bg-white">
			<div class="mx-auto max-w-5xl px-6 py-12 sm:py-14">
				<div class="max-w-2xl">
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-700">Additional Projects</p>
					<h2 class="mt-2 text-2xl font-semibold text-neutral-950">Other engineering work</h2>
				</div>
				<div class="mt-7 divide-y divide-neutral-200">
					{projects.map((project) => (
						<article class="grid gap-3 py-6 first:pt-0 last:pb-0 md:grid-cols-[260px_1fr]">
							<h3 class="text-lg font-semibold text-neutral-950">{project.title}</h3>
							<p class="text-base leading-7 text-neutral-600">{project.summary}</p>

						</article>
					))}
				</div>
			</div>
		</section>

		<section id="contact" class="border-t border-neutral-200">
			<div class="mx-auto max-w-5xl px-6 py-12 sm:py-14">
				<div class="rounded-lg border border-neutral-200 bg-neutral-950 p-6 text-white sm:p-8">
					<p class="text-sm font-semibold uppercase tracking-[0.16em] text-teal-300">Contact</p>
					<h2 class="mt-3 text-2xl font-semibold">Research collaborations and ML roles</h2>
					<p class="mt-3 max-w-2xl text-sm leading-6 text-neutral-300">
						I’m looking for Research Engineer, ML Engineer, and early-career AI for Biology roles, especially in protein modeling, protein design, and ML-driven scientific discovery. I’m also open to broader AI research engineering roles and research collaborations.
					</p>
					<div class="mt-6 flex flex-wrap gap-3">
						<a class="inline-flex min-h-11 items-center rounded-md bg-white px-4 text-sm font-semibold text-neutral-950 hover:bg-neutral-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href="mailto:xzhongal@berkeley.edu">
							xzhongal@berkeley.edu
						</a>
						<a class="inline-flex min-h-11 items-center rounded-md border border-neutral-700 px-4 text-sm font-semibold text-white hover:border-teal-300 hover:text-teal-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href="https://github.com/Kenxzk" target="_blank" rel="noreferrer">
							GitHub
						</a>
						<a class="inline-flex min-h-11 items-center rounded-md border border-neutral-700 px-4 text-sm font-semibold text-white hover:border-teal-300 hover:text-teal-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href="https://www.linkedin.com/in/xiaokun-ken-zhong/" target="_blank" rel="noreferrer">
							LinkedIn
						</a>
						<a class="inline-flex min-h-11 items-center rounded-md border border-neutral-700 px-4 text-sm font-semibold text-white hover:border-teal-300 hover:text-teal-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href="/resume.pdf">
							CV
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
