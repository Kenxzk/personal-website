---
const navItems = [
	{ label: 'Highlights', href: '/#highlights' },
	{ label: 'News', href: '/#news' },
	{ label: 'Publications', href: '/#publications' },
	{ label: 'Experience', href: '/#experience' },
	{ label: 'Projects', href: '/#projects' },
	{ label: 'Contact', href: '/#contact' },
];
---

<header class="border-b border-neutral-200 bg-neutral-50/95">
	<nav class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-5 sm:flex-row sm:items-center sm:justify-between" aria-label="Primary navigation">
		<a href="/" class="text-base font-semibold text-neutral-950 transition hover:text-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700">
			Xiaokun (Ken) Zhong
		</a>
		<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-neutral-600">
			{navItems.map((item) => (
				<a href={item.href} class="transition hover:text-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-700">
					{item.label}
				</a>
			))}
		</div>
	</nav>
</header>
